<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The generated interop of the job object that accounts a truth workload's processor time. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- For each candidate provider's registered schema, read as the product's inventory reads it. -->
    <ProjectReference Include="../../src/InterCat.Capture.Windows/InterCat.Capture.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A lab probe, not a product adapter: it lists the machine's registered providers by name, to find those that could
         record a window message, the clipboard or DDE, before any source is measured against a truth fixture. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
</Project>
