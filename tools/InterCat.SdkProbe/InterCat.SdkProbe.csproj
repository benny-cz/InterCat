<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- For a session icat record published, read as the product reads one, and its messages derived as the product derives them. -->
    <ProjectReference Include="../../src/InterCat.Storage/InterCat.Storage.csproj" />
    <ProjectReference Include="../../src/InterCat.Analysis/InterCat.Analysis.csproj" />
    <!-- The machine's processor time, read as WinINet's capture impact read it, for what keeping the SDK's content costs. -->
    <ProjectReference Include="../../src/InterCat.Capture.Windows/InterCat.Capture.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A lab probe, not a product adapter: it waits until ETW lists the capture's session running, as logman would. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
</Project>
