<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The window answers questions in bursts, each first answer within a budget: without dynamic profile-guided
         optimization, code not compiled ahead of time runs uninstrumented and hot code is compiled again once, not twice,
         which made a first evidence page faster at every tier (ADR-116's addendum, revision 1091). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../InterCat.Domain/InterCat.Domain.csproj" />
    <ProjectReference Include="../InterCat.Application/InterCat.Application.csproj" />
    <ProjectReference Include="../InterCat.Storage/InterCat.Storage.csproj" />
    <ProjectReference Include="../InterCat.Capture.Journal/InterCat.Capture.Journal.csproj" />
    <ProjectReference Include="../InterCat.CaptureBroker.Protocol/InterCat.CaptureBroker.Protocol.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <InternalsVisibleTo Include="InterCat.Ui.Tests" />
    <InternalsVisibleTo Include="InterCat.Desktop.Tests" />
  </ItemGroup>
  <Import Project="../InterCat.BrokerStage.targets" />
</Project>
