<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:InterCat.Application"
        xmlns:pres="using:InterCat.Desktop.Presentation"
        xmlns:local="using:InterCat.Desktop"
        x:Class="InterCat.Desktop.MainWindow"
        x:DataType="local:WorkspaceViewModel"
        Title="InterCat · IPC Explorer"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        Background="{DynamicResource Surface.Canvas}">
  <Grid ColumnDefinitions="250,*,286" RowDefinitions="64,Auto,*,36">

    <!-- Left rail: ranked processes. Every canvas selection is reachable from this list (R15). -->
    <Border Grid.RowSpan="4" Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,20,18,14">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource Family.Tcp.Fill}">
              <TextBlock Text="I" FontSize="15" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="InterCat" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Margin="36,1,0,0" Text="IPC EXPLORER" Classes="eyebrow" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,30,0,14" Spacing="6">
          <TextBlock Text="RANKED PROCESSES" Classes="eyebrow" />
          <TextBlock Text="Select a process to link every pane" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Snapshot.Processes}"
                 SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 AutomationProperties.Name="Ranked processes">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:ProcessNode">
              <Grid ColumnDefinitions="34,*,Auto" Margin="2,5" MinHeight="42">
                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Surface.Elevated}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name[0]}" Foreground="{DynamicResource Ink.Accent}"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Role}" Classes="muted" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ProcessId}" Classes="muted" FontSize="11"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="10" CornerRadius="8"
                Background="{DynamicResource Surface.Elevated}">
          <StackPanel Spacing="4">
            <TextBlock Text="PROTOTYPE DATA" Classes="eyebrow" />
            <TextBlock Text="No live capture is running. Values are deterministic synthetic evidence."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Header -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Padding="20,11"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1"
            Background="{DynamicResource Surface.Panel}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding Snapshot.Title}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Whole machine  ›  all processes  ›  24-second synthetic window"
                     Classes="muted" FontSize="11" />
        </StackPanel>
        <Border Grid.Column="1" Margin="0,0,12,0" Padding="10,5" CornerRadius="12"
                Background="{DynamicResource Surface.Elevated}">
          <TextBlock Text="L0 · OVERVIEW" Foreground="{DynamicResource Ink.Accent}" FontSize="11" FontWeight="SemiBold" />
        </Border>
        <Button Grid.Column="2" Margin="0,0,8,0" Content="{Binding TableToggleLabel}" Click="ToggleTables"
                AutomationProperties.Name="Toggle the accessible table equivalents" />
        <Button Grid.Column="3" Content="Clear selection (Esc)" Click="ClearSelection" />
      </Grid>
    </Border>

    <!-- Legend: hue is never the only channel, so each entry carries a glyph and a word (R14). -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Padding="20,8"
            Background="{DynamicResource Surface.Canvas}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="16"
                  AutomationProperties.Name="Mechanism legend">
        <TextBlock Text="LEGEND" Classes="eyebrow" VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Legend}"
                      AutomationProperties.Name="Mechanism legend entries">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pres:LegendEntry">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Hatch means a coverage gap · open outline means unmeasured"
                   Classes="muted" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Panes -->
    <Grid Grid.Column="1" Grid.Row="2" RowDefinitions="*,6,*" Margin="16">
      <Border Grid.Row="0" CornerRadius="10" Background="{DynamicResource Surface.Plot}"
              BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="48,*">
          <Border Padding="14,9" BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="COMMUNICATION GRAPH" Classes="eyebrow" />
                <TextBlock Text="Processes and qualified relationships" Classes="muted" FontSize="11" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="Click a node · arrow keys move focus · Tab reaches the table"
                         Classes="muted" FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <local:GraphView x:Name="GraphSurface" Grid.Row="1" Focusable="True"
                           AutomationProperties.Name="Communication graph" />
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Height="6" Background="Transparent" />

      <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource Surface.Plot}"
              BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="48,*">
          <Border Padding="14,9" BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="ACTIVITY TIMELINE" Classes="eyebrow" />
                <TextBlock Text="Observed records · 1 second buckets · unknown stays unknown"
                           Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="Wheel to zoom · arrows to pan · Home and End for the extent"
                         Classes="muted" FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <local:TimelineView x:Name="TimelineSurface" Grid.Row="1" Focusable="True"
                              AutomationProperties.Name="Activity timeline" />
        </Grid>
      </Border>
    </Grid>

    <!-- Inspector -->
    <Border Grid.Column="2" Grid.Row="2" Margin="0,16,16,16" Padding="16" CornerRadius="10"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Text="INSPECTOR" Classes="eyebrow" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
          <TextBlock Text="{Binding SelectionTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectionSubtitle}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="2" Margin="0,18,0,0" Padding="12" CornerRadius="8"
                Background="{DynamicResource Surface.Elevated}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Text="Time scope" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding IntervalLabel}" HorizontalAlignment="Right"
                         TextWrapping="Wrap" TextAlignment="Right" />
            </Grid>
            <StackPanel Spacing="3">
              <TextBlock Text="Evidence" Classes="muted" />
              <TextBlock Text="{Binding EvidenceSummary}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,20,0,0" Spacing="8">
          <TextBlock Text="EVIDENCE QUALITY" Classes="eyebrow" />
          <Border Padding="10" CornerRadius="7" Background="{DynamicResource Surface.Elevated}"
                  BorderBrush="{DynamicResource Family.Alpc.Ink}" BorderThickness="1">
            <TextBlock Text="● Direct transport evidence" Foreground="{DynamicResource Family.Alpc.Ink}" />
          </Border>
          <Border Padding="10" CornerRadius="7" Background="{DynamicResource Surface.Elevated}"
                  BorderBrush="{DynamicResource Family.RemoteCall.Ink}" BorderThickness="1,1,1,1">
            <TextBlock Text="◆ Candidate relationships stay qualified"
                       Foreground="{DynamicResource Family.RemoteCall.Ink}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="4" VerticalAlignment="Bottom" Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="This screen validates interaction and visual hierarchy only. It makes no Windows capture coverage claim." />
      </Grid>
    </Border>

    <!-- Accessible table equivalents: the same result set the canvas shows, reachable by keyboard (R15). -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="16,16,16,16" CornerRadius="10"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Ink.Accent}" BorderThickness="1"
            IsVisible="{Binding ShowTables}">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*" Margin="16">
        <TextBlock Text="RELATIONSHIP TABLE" Classes="eyebrow" />
        <Grid Grid.Row="1" ColumnDefinitions="18,140,140,120,150,110" Margin="2,8,0,2">
          <TextBlock Grid.Column="1" Text="Source" Classes="columnHeader" />
          <TextBlock Grid.Column="2" Text="Target" Classes="columnHeader" />
          <TextBlock Grid.Column="3" Text="Mechanism" Classes="columnHeader" />
          <TextBlock Grid.Column="4" Text="Bytes" Classes="columnHeader" />
          <TextBlock Grid.Column="5" Text="Evidence" Classes="columnHeader" />
        </Grid>
        <ListBox Grid.Row="2" Margin="0,4,0,0"
                 ItemsSource="{Binding Relationships}"
                 SelectedItem="{Binding SelectedRelationship, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Relationship table, the table equivalent of the communication graph">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pres:RelationshipRow">
              <Grid ColumnDefinitions="18,140,140,120,150,110" Margin="2,4"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Text="{Binding Source}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Target}" />
                <TextBlock Grid.Column="3" Text="{Binding Mechanism}" Classes="muted" />
                <TextBlock Grid.Column="4" Text="{Binding KnownBytes}" />
                <TextBlock Grid.Column="5" Text="{Binding Evidence}" Classes="muted" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="INTERVAL TABLE" Classes="eyebrow" />
        <Grid Grid.Row="4" ColumnDefinitions="18,160,120,150,150" Margin="2,8,0,2">
          <TextBlock Grid.Column="1" Text="Window" Classes="columnHeader" />
          <TextBlock Grid.Column="2" Text="Observations" Classes="columnHeader" />
          <TextBlock Grid.Column="3" Text="Bytes" Classes="columnHeader" />
          <TextBlock Grid.Column="4" Text="Coverage" Classes="columnHeader" />
        </Grid>
        <ListBox Grid.Row="5" Margin="0,4,0,0"
                 ItemsSource="{Binding Intervals}"
                 SelectedItem="{Binding SelectedIntervalRow, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Interval table, the table equivalent of the activity timeline">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pres:IntervalRow">
              <Grid ColumnDefinitions="18,160,120,150,150" Margin="2,4"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Text="{Binding Window}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Observations}" />
                <TextBlock Grid.Column="3" Text="{Binding KnownBytes}" />
                <TextBlock Grid.Column="4" Text="{Binding Coverage}" Classes="muted" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Health strip -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Padding="16,0"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock Text="●" Foreground="{DynamicResource Family.Alpc.Ink}" />
        <TextBlock Grid.Column="1" Margin="6,0,18,0" Text="Synthetic snapshot ready"
                   Foreground="{DynamicResource Ink.Body}" FontSize="11" />
        <TextBlock Grid.Column="2" Text="Coverage gap: 2 seconds · not extrapolated"
                   Foreground="{DynamicResource Family.RemoteCall.Ink}" FontSize="11" />
        <TextBlock Grid.Column="3" Text="M0 interaction prototype" Classes="muted" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
