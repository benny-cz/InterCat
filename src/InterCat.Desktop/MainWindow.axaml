<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:InterCat.Application"
        xmlns:pres="using:InterCat.Desktop.Presentation"
        xmlns:local="using:InterCat.Desktop"
        x:Class="InterCat.Desktop.MainWindow"
        x:DataType="local:WorkspaceViewModel"
        Title="InterCat · IPC Explorer"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        Background="{DynamicResource Surface.Canvas}">
  <Grid x:Name="WindowGrid" RowDefinitions="Auto,Auto,*,36">
    <!-- The rail widens with a wide window, and its edge can be dragged, so long names and a channel's ends read whole. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" MinWidth="220" MaxWidth="560" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="286" />
    </Grid.ColumnDefinitions>

    <!-- Left rail: ranked processes. Every canvas selection is reachable from this list (R15). -->
    <Border x:Name="Rail" Grid.RowSpan="4" Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,1,0">
      <Grid x:Name="RailGrid" RowDefinitions="Auto,Auto,*,Auto" Margin="18,20,18,14">
        <StackPanel Spacing="2" Margin="0,0,0,26">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource Action.Fill}">
              <TextBlock Text="I" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Action.Ink}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="InterCat" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Margin="36,1,0,0" Text="IPC EXPLORER" Classes="eyebrow" />
        </StackPanel>

        <!-- The ranked table's heading, summary, hints and search, while a session is shown; with none, the saved sessions
             stand where the ranked table will be (section 3.1 step 1). -->
        <StackPanel x:Name="RankedTableHeader" Grid.Row="1" Margin="0,0,0,10" Spacing="5"
                    IsVisible="{Binding ShowsRankedHeader}" Grid.IsSharedSizeScope="True">
          <!-- The rung's badge follows the heading, and wraps under it where the rail is too narrow for both: a long one,
               L4 · OPERATION, never lies over the heading (R15). -->
          <WrapPanel x:Name="RankedHeading" Orientation="Horizontal" ItemSpacing="10" LineSpacing="2">
            <TextBlock Text="RANKED TABLE" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LevelBadge}" Classes="eyebrow"
                       Foreground="{DynamicResource Ink.Accent}" VerticalAlignment="Center" />
          </WrapPanel>
          <TextBlock Text="{Binding LevelSummaryShort}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.Name="What the ranked table holds" />
          <!-- §6.1's metric selector: what the machine and group rungs rank by. A byte ranking says what it measured, and
               ranks a row whose records recorded no size after every measured row, never as zero (§5.2). -->
          <!-- The basis a ranking is on stays on screen beside it (§3.2): observations or operations, in full on hover. -->
          <Grid Margin="0,2,0,0" IsVisible="{Binding ShowsRankingChoice}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SelectorLabel" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="Rank by" Classes="muted" FontSize="11" />
              <TextBlock x:Name="RankingBasisText" Text="{Binding RankingBasis}" Classes="muted" FontSize="9"
                         ToolTip.Tip="{Binding RankingBasisDetail}"
                         AutomationProperties.HelpText="{Binding RankingBasisDetail}" />
            </StackPanel>
            <ComboBox x:Name="RankBySelector" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="28" FontSize="11"
                      ItemsSource="{Binding RankingOptions}"
                      SelectedItem="{Binding SelectedRanking, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static local:WorkspaceViewModel.RankingDefinition}"
                      AutomationProperties.Name="Rank groups and processes by"
                      AutomationProperties.HelpText="{x:Static local:WorkspaceViewModel.RankingDefinition}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:RankingOption">
                  <StackPanel>
                    <TextBlock Text="{Binding BasisHeading}" Classes="eyebrow" IsVisible="{Binding OpensBasis}" Margin="0,2,0,4" />
                    <TextBlock Text="{Binding Label}" AutomationProperties.Name="{Binding AccessibleName}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="local:RankingOption">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
            </ComboBox>
            <!-- §5.2's rate: a count or sum per second over the interval the rows count, in the order of its total. It sits
                 on the selector's own row, since the rail's height is the ranked rows'; a median or a distinct count has
                 no rate, so it steps aside for them. -->
            <ToggleButton x:Name="PerSecondToggle" Grid.Column="2" Content="/s" Margin="6,0,0,0" MinHeight="28" MinWidth="30"
                          FontSize="11" Padding="6,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                          IsChecked="{Binding PerSecond, Mode=TwoWay}" IsVisible="{Binding OffersPerSecond}"
                          ToolTip.Tip="Per second: state each row's value per second over the whole interval the rows count - the one brushed or zoomed to, or the whole recording. The rows keep the order of their totals; a session whose capture recorded no stop, such as an import, needs an interval brushed or zoomed to."
                          AutomationProperties.Name="Per second: state each row's value per second over the interval the rows count" />
          </Grid>
          <!-- §6.3's grouping: by executable, or by the terminal session each process's lifecycle records name. It stands at
               the machine rung, whose rows are the groups, once a session is named, its box beneath the ranking's; a choice
               regroups the overview already projected and reads nothing again. -->
          <Grid x:Name="GroupByRow" Margin="0,2,0,0" IsVisible="{Binding ShowsGroupingChoice}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SelectorLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Group by" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="GroupBySelector" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="28" FontSize="11"
                      ItemsSource="{Binding GroupingOptions}"
                      SelectedItem="{Binding SelectedGrouping, Mode=OneWay}"
                      SelectionChanged="GroupingChosen"
                      ToolTip.Tip="{x:Static local:WorkspaceViewModel.GroupingDefinition}"
                      AutomationProperties.Name="Group processes by"
                      AutomationProperties.HelpText="{x:Static local:WorkspaceViewModel.GroupingDefinition}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:GroupingOption">
                  <TextBlock Text="{Binding Label}" AutomationProperties.Name="{Binding AccessibleName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock x:Name="RankingNote" Text="{Binding RankingNote}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding ShowsRankingNote}" ToolTip.Tip="{Binding RankingNoteDetail}"
                     AutomationProperties.Name="What the ranking measured"
                     AutomationProperties.HelpText="{Binding RankingNoteDetail}" />
          <!-- A brushed interval, or else the zoomed timeline's visible range, re-ranks every rung; the scope is stated
               where the totals are read, and a range that follows the view can be kept (plan §6.4). -->
          <TextBlock x:Name="RankingScope" Text="{Binding RankingScopeText}" Foreground="{DynamicResource Ink.Accent}" FontSize="11"
                     TextWrapping="Wrap" IsVisible="{Binding ShowsRankingScope}"
                     AutomationProperties.Name="The time range the ranking counts" />
          <Button x:Name="KeepRangeButton" Content="Keep this range" Click="KeepVisibleRange" FontSize="11"
                  Padding="8,2" HorizontalAlignment="Left" IsVisible="{Binding CanKeepVisibleRange}"
                  AutomationProperties.HelpText="Keep the visible range as the analysis interval, so zooming and panning no longer change what the ranking counts" />
          <!-- §6.8: an evidence policy other than the default is never invisible, and one action restores the default. -->
          <StackPanel x:Name="EvidencePolicyPanel" Spacing="4" IsVisible="{Binding CountsCandidates}">
            <TextBlock x:Name="EvidencePolicyText" Text="{Binding EvidencePolicyNote}" Foreground="{DynamicResource Ink.Accent}"
                       FontSize="11" TextWrapping="Wrap" />
            <Button x:Name="CountCorrelatedOnlyButton" Click="CountCorrelatedOnly"
                    FontSize="11" Padding="8,2" HorizontalAlignment="Left"
                    AutomationProperties.HelpText="Leave a reused PID's candidates out of every count again, as by default">
              <TextBlock Text="Count correlated evidence only" TextWrapping="Wrap" />
            </Button>
          </StackPanel>
          <!-- §19.5's view filter: which processes are InterCat's own, beside the command that sets them aside from the rows,
               the graph and the channels, or shows them again; the timeline and the evidence still count their records. One
               line, since the rail's height is its ranked rows', and its tooltip says it whole. -->
          <DockPanel x:Name="CollectorsPanel" IsVisible="{Binding OffersCollectorsAside}">
            <Button x:Name="CollectorsAsideButton" DockPanel.Dock="Right" Content="{Binding CollectorsCommand}"
                    Click="ToggleCollectorsAside" FontSize="11" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.HelpText="Set InterCat's own processes aside from the ranked rows, the graph and the channels, or show them again; no record is removed, and the timeline and the evidence still count theirs" />
            <TextBlock x:Name="CollectorsLineText" Text="{Binding CollectorsLine}" Classes="muted" FontSize="11"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding CollectorsText}" AutomationProperties.HelpText="{Binding CollectorsText}" />
          </DockPanel>
          <!-- §6.8: a setting changed from its first-run default is shown as changed - the ranking and its rate, the lanes'
               scale, the grouping and the evidence policy, in the words an investigation keeps them in - and one command
               restores them all. -->
          <DockPanel x:Name="DefaultsPanel" IsVisible="{Binding DiffersFromDefaults}">
            <Button x:Name="RestoreDefaultsButton" DockPanel.Dock="Right" Content="Restore defaults" Click="RestoreDefaultView"
                    FontSize="11" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.HelpText="Rank by records again, not per second, read every timeline lane on one scale, group processes by executable, count correlated evidence only and show InterCat's own processes; the time, selection and pins stay" />
            <TextBlock x:Name="ChangedSettingsLine" Text="{Binding ChangedSettingsSummary}" Classes="muted" FontSize="11"
                       TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{Binding ChangedSettingsText}"
                       AutomationProperties.HelpText="{Binding ChangedSettingsText}" />
          </DockPanel>
          <TextBlock Text="{Binding DescendHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <!-- A narrow rail ends the placeholder in an ellipsis, so its tooltip says it whole, shortcut included. -->
          <TextBox x:Name="SearchBox" Margin="0,6,0,0" Watermark="Search names, PIDs or a time (Ctrl+F)"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip.Tip="Search names, PIDs or a time (Ctrl+F)"
                   AutomationProperties.Name="Search this session by name, process ID or channel endpoint, or type a time to go to it: 14:32:05 on the wall clock, or 312.5 s of session time"
                   AutomationProperties.AcceleratorKey="Ctrl+F" />
          <!-- What a search found, or why a time typed places nothing, is said as it changes, without taking the keyboard. -->
          <TextBlock Text="{Binding SearchSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding IsSearching}" AutomationProperties.Name="Search result status"
                     AutomationProperties.LiveSetting="Polite" />
          <!-- While records are read, the view holds its generation; a newer one is offered, never forced (section 5.2). -->
          <Border x:Name="HeldBanner" IsVisible="False" Margin="0,6,0,0" Padding="8" CornerRadius="7"
                  Background="{DynamicResource Surface.Elevated}"
                  BorderBrush="{DynamicResource Ink.Accent}" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock x:Name="HeldBannerText" FontSize="11" TextWrapping="Wrap"
                         AutomationProperties.Name="Newer evidence is published" />
              <Button Content="Update to newest (F5)" Click="UpdateHeldGeneration"
                      AutomationProperties.HelpText="Show the newest published generation" />
              <Button x:Name="HeldFollowButton" Content="Follow live (F)" Click="ToggleFollow" IsVisible="False"
                      AutomationProperties.HelpText="Resume following each new publication" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
          <!-- While no session is open, the sessions the user saved are one gesture away rather than a path to remember
               (section 3.1). Listing reads each session's manifest only; opening one verifies it in full. -->
          <StackPanel x:Name="RecentSessionsPanel" Spacing="4" IsVisible="False" Margin="0,0,0,8">
            <TextBlock Text="RECENT SESSIONS" Classes="eyebrow" />
            <ListBox x:Name="RecentSessionsList" MaxHeight="260" Background="Transparent" BorderThickness="0"
                     DoubleTapped="OpenRecentSession"
                     AutomationProperties.Name="Recent sessions; press Enter to open the selected one">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="pres:RecentSessionRow">
                  <StackPanel Margin="2,4" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Path}" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <ListBox x:Name="SearchResultsList" Grid.Row="1" ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" IsVisible="{Binding IsSearching}"
                   DoubleTapped="OpenSearchHit"
                   AutomationProperties.Name="Search results; press Enter to open the selected result">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pres:SearchRow">
                <StackPanel Margin="2,5" Spacing="2" MinHeight="44">
                  <TextBlock Text="{Binding Kind}" Classes="eyebrow" />
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Observations}" Classes="muted" FontSize="10"
                             IsVisible="{Binding Observations, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="RungList" Grid.Row="1"
                   ItemsSource="{Binding RungRows}"
                   SelectedItem="{Binding SelectedRung, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   IsVisible="{Binding ShowsRankedTable}"
                   DoubleTapped="DescendFromRow"
                   AutomationProperties.Name="Ranked table for the current level">
            <!-- §6.7: a row in the multi-selection carries an accent bar at its edge, a group only partly in it a thinner
                 one, drawn inside the row as its selection ring is, so neither moves the row's content; the selected
                 row of either keeps its ring. The code-behind sets the classes and the item status a screen reader hears. -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem.chosen /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BoxShadow" Value="{DynamicResource ListItem.ChosenBar}" />
              </Style>
              <Style Selector="ListBoxItem.chosenPart /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BoxShadow" Value="{DynamicResource ListItem.ChosenPartBar}" />
              </Style>
              <Style Selector="ListBoxItem.chosen:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BoxShadow" Value="{DynamicResource ListItem.ChosenSelectedRing}" />
              </Style>
              <Style Selector="ListBoxItem.chosenPart:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BoxShadow" Value="{DynamicResource ListItem.ChosenPartSelectedRing}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pres:RungRow">
                <!-- The name has the rail's width less the count; its detail and coverage share the line beneath. -->
                <Grid ColumnDefinitions="22,*,Auto" RowDefinitions="Auto,Auto" Margin="2,5" MinHeight="44"
                      VerticalAlignment="Center">
                  <!-- §6.7's Ctrl+click and Ctrl+Space, as a menu a pointer or a context-menu key reaches. -->
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Add to or remove from the selection (Ctrl+Space)" Click="ToggleRowInSelection" />
                      <MenuItem Header="{Binding OtherEndMenu}" IsVisible="{Binding HasOtherEnd}" Click="OpenOtherEndOfRow" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Margin="6,0,6,0" Text="{Binding Label}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
                  <TextBlock Grid.Column="2" Text="{Binding Figure}" FontSize="11" TextAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,0,0,0"
                             Text="{Binding DetailLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding DetailLine}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- A rung with no data names the source that would supply it, never an empty pane (section 3.2).
               At the minimum window height the reason scrolls rather than being clipped. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsEmptyReason}">
            <Border Classes="card" Padding="11" CornerRadius="8" VerticalAlignment="Top"
                    Background="{DynamicResource Surface.Elevated}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding EmptyHeading}" Classes="eyebrow" />
                <TextBlock Text="{Binding EmptyReason}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.Name="Why this level has no rows" />
                <!-- Evidence is one step from every rung; an empty rung offers that step where the reason is read. A
                     narrow rail wraps its label rather than cutting off the key that takes it. -->
                <Button x:Name="EmptyEvidenceButton" Click="ShowSourceRecords"
                        IsVisible="{Binding OffersEvidenceStep}"
                        AutomationProperties.HelpText="Show this rung's source records">
                  <TextBlock Text="Show source records (E)" TextWrapping="Wrap" />
                </Button>
                <!-- A rung its records were left out of as candidates offers to count them where that is read, as the
                     inspector's explanation does (§6.8). -->
                <Button x:Name="EmptyCountCandidatesButton" Click="CountCandidates"
                        IsVisible="{Binding OffersRungCandidates}"
                        AutomationProperties.HelpText="Count every reused PID's later holder's records as its own, as candidates, in every count, ranking and record list of this session">
                  <TextBlock Text="Count them as candidates" TextWrapping="Wrap" />
                </Button>
              </StackPanel>
            </Border>
          </ScrollViewer>

          <Button Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                  Content="{Binding LoadMoreLabel}" Click="LoadMoreRecords"
                  IsVisible="{Binding ShowsLoadMore}"
                  AutomationProperties.Name="{Binding LoadMoreName}" />
        </Grid>

        <!-- The rail's actions scroll within the height its list leaves them, so a card never runs past the window and the
             ranked rows or saved sessions above keep a row or two in view (R15). -->
        <ScrollViewer x:Name="RailActions" Grid.Row="3" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
        <!-- A capture a crashed or interrupted viewer left unfinished: the broker kept its evidence, and the next launch
             offers to finish the session from it (section 3.1 step 6). Hidden unless there is something to offer. -->
        <Border x:Name="UnfinishedCaptureCard" Classes="card" Padding="9" CornerRadius="8" IsVisible="False"
                Background="{DynamicResource Surface.Elevated}">
          <StackPanel Spacing="6">
            <TextBlock Text="UNFINISHED CAPTURE" Classes="eyebrow" Foreground="{DynamicResource Status.Caution}" />
            <TextBlock x:Name="UnfinishedCaptureHeadline" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.Name="Unfinished capture" />
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="What the broker kept and what finishing does; scroll for all of it">
              <TextBlock x:Name="UnfinishedCaptureDetail" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </ScrollViewer>
            <!-- Side by side when they fit, so the Explore card below keeps its actions in view at the minimum window. -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button x:Name="FinishCaptureButton" FontSize="13" IsVisible="False" Click="FinishInterruptedCapture" />
              <Button x:Name="ForgetCaptureButton" Content="Forget" FontSize="13" Click="ForgetInterruptedCapture"
                      ToolTip.Tip="{x:Static pres:InterruptedCaptureOffer.ForgetExplanation}"
                      AutomationProperties.HelpText="Stop offering to finish this capture; the session and the evidence stay" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="9" CornerRadius="8"
                Background="{DynamicResource Surface.Elevated}">
          <!-- Six apart, so the Keep choice fits beside a shown session's lines at the smallest window (§6.1). -->
          <StackPanel Spacing="6">
            <!-- First-run guidance, as the line beneath it is: once a session is shown the card's action names itself. -->
            <TextBlock x:Name="CaptureEyebrow" Text="EXPLORE THIS MACHINE" Classes="eyebrow" />
            <TextBlock x:Name="CaptureIntro"
                       Text="Explore records supported process and TCP activity; it cannot see every IPC message or payload."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <!-- §20.2: what the capture keeps - every record of ten minutes, the default that needs no configuration, or the
                 newest stretch of session time of one that records until stopped, its older records released as it
                 records (ADR-045). Chosen before a capture starts; it says what the choice does beneath it. -->
            <Grid x:Name="CaptureKeepRow" ColumnDefinitions="Auto,*">
              <TextBlock Text="Keep" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="CaptureKeepSelector" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="28" FontSize="11"
                        ItemsSource="{x:Static local:CaptureKeepChoice.All}" SelectedIndex="0"
                        SelectionChanged="CaptureKeepChosen"
                        AutomationProperties.Name="What the capture keeps"
                        AutomationProperties.HelpText="Every record of a ten-minute capture, or the newest stretch of session time of one that records until it is stopped">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:CaptureKeepChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <!-- The narrowest rail ends the chosen label in an ellipsis, which the selector's tooltip completes. -->
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="local:CaptureKeepChoice">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="CaptureKeepNote" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="False"
                       AutomationProperties.Name="What the chosen capture keeps" />
            <!-- The card's buttons are a size smaller, so "Retry exploring (Ctrl+R)" fits the rail's 250 px whole. -->
            <Button x:Name="StartExploringButton" Content="Start exploring (Ctrl+R)" FontSize="13" Classes="primary"
                    Click="StartExploring" AutomationProperties.HelpText="Start the default Explore capture" />
            <!-- An unavailable capture must be explained beside the action that failed, not after the other controls. -->
            <TextBlock x:Name="CaptureStatus" Text="Ready to explore" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap" AutomationProperties.Name="Capture status" />
            <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Capture status detail; scroll for the full reason">
              <TextBlock x:Name="CaptureDetail" Text="No configuration or destination is required."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </ScrollViewer>
            <Button x:Name="StopCaptureButton" Content="Stop and save" IsVisible="False" Classes="primary"
                    Click="StopCapture" AutomationProperties.HelpText="Stop recording and save published evidence" />
            <!-- Pausing the view is not pausing the capture: recording continues and the newest view is offered (§6.2). -->
            <Button x:Name="FollowButton" Content="Pause view (F)" IsVisible="False" FontSize="13"
                    Click="ToggleFollow" AutomationProperties.HelpText="Pause or resume following the live capture" />
            <Button x:Name="OpenSavedSessionButton" Content="Open saved session" FontSize="13"
                    Click="OpenSavedSession" AutomationProperties.HelpText="Open an existing InterCat session" />
            <!-- An investigation spans sessions captured apart, on this machine or others (ADR-038). -->
            <Button x:Name="InvestigationButton" Content="Investigation" FontSize="13"
                    AutomationProperties.HelpText="Open or start an investigation over several sessions">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem x:Name="OpenInvestigationItem" Header="Open investigation…" Click="OpenInvestigation"
                            AutomationProperties.HelpText="Open an investigation file" />
                  <MenuItem x:Name="NewInvestigationItem" Header="New investigation…" Click="NewInvestigation"
                            AutomationProperties.HelpText="Start a new investigation file" />
                  <MenuItem x:Name="ExploreDemoItem" Header="Explore the demo" Click="ExploreDemo"
                            AutomationProperties.HelpText="Open InterCat's generated demo investigation of two hosts; nothing in it was captured" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- §14 M5: InterCat's generated demo of two hosts, to try every view without capturing; it says what it is. Offered
                 here before any session is shown, and always in the Investigation menu, so it never takes the ranked list's room. -->
            <Button x:Name="ExploreDemoButton" Content="Explore the demo" FontSize="13" Click="ExploreDemo"
                    AutomationProperties.HelpText="Open InterCat's generated demo investigation of two hosts; nothing in it was captured" />
            <!-- First feedback is stated, not implied: how soon the first view arrived and how often it refreshes. A line
                 that says nothing takes no room from the ranked list. -->
            <TextBlock x:Name="CaptureLatency" Classes="muted" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       AutomationProperties.Name="How fresh the live view is" />
            <!-- §12.1 S5: growth is disclosed before it hurts - the session's size as measured, its tier, and while it
                 records, when its capture's limits stop it. Caution ink when that is a minute away or the size is past T3. -->
            <TextBlock x:Name="SessionGrowthText" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="False"
                       AutomationProperties.Name="Session size and growth" />
            <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding #CaptureSummary.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock x:Name="CaptureSummary" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </ScrollViewer>
            <!-- One line however long the path: its middle segments give way to an ellipsis, the session's own folder stays,
                 and the whole path is on hover, so the card's height never turns on how a path wraps (§6.1). -->
            <TextBlock x:Name="CaptureSessionPath" Classes="muted" FontSize="10" TextTrimming="PathSegmentEllipsis"
                       ToolTip.Tip="{Binding $self.Text}"
                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <GridSplitter x:Name="RailSplitter" Grid.RowSpan="4" Width="5" HorizontalAlignment="Right"
                  ResizeDirection="Columns" Background="Transparent"
                  ToolTip.Tip="Drag to widen the ranked table"
                  AutomationProperties.Name="Ranked table width; left and right arrows resize it" />

    <!-- Header -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Padding="20,11"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1"
            Background="{DynamicResource Surface.Panel}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Spacing="2" ClipToBounds="True">
          <TextBlock x:Name="HeaderTitle" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <!-- The breadcrumb states the position at every rung, and each crumb returns to it (section 3.2).
               It scrolls rather than pushing the header wider, so a deep rung cannot overrun the title. -->
          <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ListBox x:Name="CrumbList"
                   ItemsSource="{Binding Crumbs}"
                   SelectedItem="{Binding SelectedCrumb, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   AutomationProperties.Name="Breadcrumb of the detail ladder">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pres:CrumbRow">
                <TextBlock Text="{Binding Display}" FontSize="11" Padding="4,1"
                           TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip.Tip="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </ScrollViewer>
        </StackPanel>
        <Border Grid.Column="1" Margin="0,0,12,0" Padding="10,5" CornerRadius="12"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Elevated}">
          <TextBlock Text="{Binding LevelBadge}" Foreground="{DynamicResource Ink.Accent}"
                     FontSize="11" FontWeight="SemiBold" />
        </Border>
        <Button Grid.Column="2" Margin="0,0,8,0" Content="{Binding TableToggleLabel}" Click="ToggleTables"
                AutomationProperties.HelpText="Toggle the accessible table equivalents" />
        <!-- Alt+Right's visible equivalent (R15), shown while an ascent or a crumb has left a rung to re-enter. It stands
             left of Back so Back never moves under a pointer that clicks it again and again. Its face is one word, so
             the title and breadcrumb keep their room at the minimum width; the rung it re-enters and its shortcut are in
             its tooltip and its accessible name. -->
        <Button x:Name="ForwardButton" Grid.Column="3" Margin="0,0,8,0" Content="Forward"
                Click="GoForward" IsVisible="{Binding CanGoForward}" ToolTip.Tip="{Binding ForwardLabel}"
                AutomationProperties.Name="{Binding ForwardLabel}" />
        <!-- Back's face names the rung it returns to by its kind, as Forward's names none, so the title keeps its room; the
             rung itself is in its tooltip and accessible help. A face that still runs long ends in an ellipsis. -->
        <Button x:Name="AscendButton" Grid.Column="4" Click="AscendOrClear" MaxWidth="280"
                ToolTip.Tip="{Binding AscendDetail}"
                AutomationProperties.Name="{Binding AscendLabel}"
                AutomationProperties.HelpText="{Binding AscendDetail}">
          <TextBlock x:Name="AscendText" Text="{Binding AscendLabel}" TextTrimming="CharacterEllipsis" />
        </Button>
        <!-- The application's settings (section 26.3): the theme, and where the settings are kept. -->
        <Button x:Name="ThemeButton" Grid.Column="5" Margin="8,0,0,0" Content="Theme"
                AutomationProperties.Name="Theme: choose light, dark or high contrast, or follow the system">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" />
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Legend: hue is never the only channel, so each entry carries a glyph and a word (R14). -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Padding="20,8"
            Background="{DynamicResource Surface.Canvas}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="6"
                 AutomationProperties.Name="Mechanism legend">
        <TextBlock Text="LEGEND" Classes="eyebrow" VerticalAlignment="Center" />
        <ItemsControl x:Name="LegendList" ItemsSource="{Binding Legend}"
                      AutomationProperties.Name="Mechanism legend entries">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pres:LegendEntry">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding FillBrush}" />
                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding InkBrush}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The hatch keyed by a swatch of itself. Only marks the panes draw are keyed: the unmeasured value only while the
             graph draws one, and the outlined marks an L3 end draws are records with no data direction. -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    AutomationProperties.Name="Hatching: a coverage gap, or coverage not yet known">
          <local:CoverageKeySample x:Name="CoverageKeySwatch" VerticalAlignment="Center" />
          <TextBlock x:Name="CoverageLegendText" Text="Coverage gap or unknown"
                     Classes="muted" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <!-- §6.6's unmeasured value, keyed by a sample of itself while a pane draws one: under a byte ranking, a
             relationship whose sends recorded no size is an open cross-hatched band, and a timeline column of them an
             open cross-hatched cell, unknown rather than zero. -->
        <StackPanel x:Name="UnmeasuredLegend" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding DrawsUnmeasured}"
                    AutomationProperties.Name="Open cross-hatch: a size its records did not measure, unknown rather than zero">
          <local:UnmeasuredKeySample x:Name="UnmeasuredKeySwatch" VerticalAlignment="Center" />
          <TextBlock x:Name="UnmeasuredLegendText" Text="Size not measured"
                     Classes="muted" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <!-- §6.2: what the lanes' heights plot and the scale they are read against, with each lane's own one click away.
             One scale lets heights compare across lanes; each lane's own shows a quiet lane's shape beside a busy one,
             and the axis and every card then say so. -->
        <StackPanel x:Name="LaneScalePanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding OffersLaneScale}">
          <TextBlock Text="HEIGHT" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock x:Name="LaneScaleText" Text="{Binding LaneScaleText}" Classes="muted" FontSize="11"
                     VerticalAlignment="Center" />
          <ToggleButton x:Name="LaneScaleToggle" IsChecked="{Binding ScalesEachLane, Mode=TwoWay}" FontSize="11"
                        Padding="6,0" MinHeight="22" VerticalAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Per lane: read each lane's bars against its own busiest bar, so a quiet lane's shape shows beside a busy one. Its heights then compare with no other lane's: compare lanes by the numbers in their cards. Off, every lane shares one scale."
                        AutomationProperties.Name="Per lane: read each lane's bars against its own busiest bar rather than one scale for every lane">
            <TextBlock Text="Per lane" />
          </ToggleButton>
        </StackPanel>
        <!-- A descent may imply a filter. It is shown here, where it can be seen and removed (section 3.2). The chips
             wrap within the bar, so a deep rung's last filter is never cut off at the window's edge. -->
        <DockPanel IsVisible="{Binding HasFilters}">
          <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Text="FILTERS" Classes="eyebrow" VerticalAlignment="Center" />
          <ListBox x:Name="FilterList"
                   ItemsSource="{Binding Filters}"
                   SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Filters this descent implied. Select one and press Delete to remove it.">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pres:FilterRow">
                <TextBlock FontSize="11" Padding="4,1" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           Text="{Binding Chip}" ToolTip.Tip="{Binding Tip}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </WrapPanel>
    </Border>

    <!-- Panes. Either may fill the column by an explicit command, and only by one (§6.1): its header's Expand, or F11
         with the keyboard in it. The other comes back, at the split the person left, by the same command. -->
    <Grid x:Name="PanesGrid" Grid.Column="1" Grid.Row="2" RowDefinitions="*,6,*" Margin="16">
      <Border x:Name="GraphPane" Grid.Row="0" CornerRadius="10" Background="{DynamicResource Surface.Plot}"
              BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="48,*">
          <Border Padding="14,9" BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
            <!-- The pane's own statement gets the full width of the second line; the gesture hint shares the first line
                 with the title and yields first when the pane is narrow. -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Text="COMMUNICATION GRAPH" Classes="eyebrow" />
              <TextBlock Grid.Column="1" Margin="16,0,0,0"
                         Text="Hover explains · drag to pin · P pin/unpin · L re-layout · Enter opens a node"
                         Classes="muted" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="Hover explains a node or relationship. Click selects. Drag a node to place and pin it. P pins or unpins the selection; L lays the graph out again while keeping pins. Arrow keys move graph focus; Enter or a double click opens a group or process; Tab reaches the equivalent table." />
              <!-- What the graph draws its relationships from is said here, where they are drawn, and in full on hover. -->
              <TextBlock x:Name="GraphSummaryText" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GraphSummary}" Classes="muted" FontSize="11"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GraphScope}"
                         AutomationProperties.Name="{Binding GraphSummary}" AutomationProperties.HelpText="{Binding GraphScope}" />
              <ToggleButton x:Name="GraphExpandToggle" Grid.Column="2" Grid.RowSpan="2" Margin="12,0,0,0"
                            FontSize="11" Padding="8,0" MinHeight="26" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsCheckedChanged="GraphExpandChanged"
                            ToolTip.Tip="Expand: let the graph fill the column, the timeline one click away (F11 with the graph focused). Click again, or press F11, to give both their places back."
                            AutomationProperties.Name="Expand the graph to fill the column; again to restore the timeline beneath it">
                <TextBlock Text="Expand" />
              </ToggleButton>
            </Grid>
          </Border>
          <local:GraphView x:Name="GraphSurface" Grid.Row="1" Focusable="True"
                           AutomationProperties.Name="Communication graph" />
        </Grid>
      </Border>

      <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="6" Background="Transparent"
                    AutomationProperties.Name="Resize the graph and timeline panes" />

      <Border x:Name="TimelinePane" Grid.Row="2" CornerRadius="10" Background="{DynamicResource Surface.Plot}"
              BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="48,*,38">
          <Border Padding="14,9" BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Text="ACTIVITY TIMELINE" Classes="eyebrow" />
              <TextBlock Grid.Column="1" Margin="16,0,0,0"
                         Text="Wheel or double-click zooms · drag or ←→ pan · ↑↓ lanes · [ ] step · 0 fits"
                         Classes="muted" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="Wheel zooms at the pointer and a double click zooms in twice as far there. A drag, left/right arrows, a horizontal wheel or Shift with the wheel pan; Shift with a left/right arrow moves one bucket. At the mechanism overview, up/down scroll one lane and Page Up/Down scroll a page. + and - zoom around the analysis interval. [ and ] step to the previous or next record. Home and End go to the session's edges, and 0 fits the analysis interval or the whole session. Shift+drag brushes a range; a click selects a bucket. At a group's process lanes, P pins the selected process's lane at the top, marked, or unpins it." />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TimelineCaption}"
                         Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding TimelineCaption}" AutomationProperties.Name="{Binding TimelineCaption}" />
              <!-- §6.2: a selected process's lane can be pinned at the top of its group's lanes; P with the timeline focused. -->
              <Button x:Name="LanePinButton" Grid.Column="2" Grid.RowSpan="2" Margin="12,0,0,0"
                      FontSize="11" Padding="8,0" MinHeight="26" VerticalAlignment="Center"
                      VerticalContentAlignment="Center" Click="ToggleLanePin"
                      IsVisible="{Binding OffersLanePin}" Content="{Binding LanePinLabel}"
                      ToolTip.Tip="Pin the selected process's lane at the top of the group's lanes, marked, in the order pinned, so the lanes being compared stay together; a process folded with a large group's least busy gets a lane of its own. Again to put it back in the ranked table's order. P does the same with the timeline focused."
                      AutomationProperties.Name="{Binding LanePinLabel}" />
              <!-- §6.2's time base: instants in session time, or on the wall clock the capture's machine read, where its
                   capture recorded one; the axis, cards, time scope, interval table and evidence all follow it. -->
              <ToggleButton x:Name="WallClockToggle" Grid.Column="3" Grid.RowSpan="2" Margin="12,0,0,0"
                            FontSize="11" Padding="8,0" MinHeight="26" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsVisible="{Binding OffersWallClock}"
                            IsChecked="{Binding ReadsWallClock, Mode=TwoWay}"
                            ToolTip.Tip="{Binding WallClockTip}"
                            AutomationProperties.Name="Wall clock: read times on the clock the capture's machine kept, rather than in session time"
                            AutomationProperties.HelpText="{Binding WallClockTip}">
                <TextBlock Text="Wall clock" />
              </ToggleButton>
              <ToggleButton x:Name="TimelineExpandToggle" Grid.Column="4" Grid.RowSpan="2" Margin="12,0,0,0"
                            FontSize="11" Padding="8,0" MinHeight="26" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsCheckedChanged="TimelineExpandChanged"
                            ToolTip.Tip="Expand: let the timeline fill the column, the graph one click away (F11 with the timeline focused). Click again, or press F11, to give both their places back."
                            AutomationProperties.Name="Expand the timeline to fill the column; again to restore the graph above it">
                <TextBlock Text="Expand" />
              </ToggleButton>
            </Grid>
          </Border>
          <!-- The plot handles time gestures; the left lane-label gutter lets the parent scroll long lane lists. -->
          <ScrollViewer x:Name="TimelineLaneScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="Timeline lanes; scroll over the lane names for more rows">
            <local:TimelineView x:Name="TimelineSurface" Focusable="True"
                                AutomationProperties.Name="Activity timeline" />
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,1,0,0">
            <local:MinimapView x:Name="MinimapSurface" Margin="0,4,0,2" Focusable="True"
                               AutomationProperties.Name="Whole-session minimap"
                               ToolTip.Tip="The whole session. Wheel or +/- zooms, arrows pan, Home/End jump and 0 fits. Drag the frame to move, drag an edge to resize, click to centre or double-click to fit. Hatching marks capture gaps." />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Inspector -->
    <Border Grid.Column="2" Grid.Row="2" Margin="0,16,16,16" Padding="16" CornerRadius="10"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="INSPECTOR" Classes="eyebrow" />
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- Clear of the scroll bar, which overlays what it scrolls: the cards' edges no longer run beneath it. -->
          <StackPanel Spacing="0" Margin="0,0,10,0">
            <!-- At the evidence rung the inspector describes the selected record in words, with its original one step on. -->
            <StackPanel Spacing="8" Margin="0,0,0,18" IsVisible="{Binding IsEvidenceRung}">
              <TextBlock Text="SOURCE RECORD" Classes="eyebrow" />
              <TextBlock Text="{Binding SelectedEvidenceTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EvidenceScopeText}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                         AutomationProperties.Name="What these records are" />
              <ItemsControl x:Name="EvidenceFieldList" ItemsSource="{Binding SelectedEvidenceFields}"
                            AutomationProperties.Name="Facts of the selected record">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:EvidenceField">
                    <StackPanel Margin="0,0,0,7" Spacing="1">
                      <TextBlock Text="{Binding Label}" Classes="muted" FontSize="10" />
                      <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{Binding OriginalRecordLabel}" Click="OpenOriginalRecord"
                      IsEnabled="{Binding HasSelectedEvidence}"
                      AutomationProperties.Name="Open the selected record's original journal entry" />
              <!-- §3.7: kept content opens apart from the original record, since it is kept beside the journal (ADR-036). -->
              <Button Content="Inspect its content (C)" Click="OpenContent" IsVisible="{Binding HasSelectedContent}"
                      AutomationProperties.HelpText="Inspect the selected record's kept content" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding !IsEvidenceRung}">
              <TextBlock Text="{Binding SelectionTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectionSubtitle}" Classes="muted" TextWrapping="Wrap" />
              <!-- A chosen channel or call says what its keys do, as its row's spoken name does. -->
              <TextBlock Text="{Binding SelectionActions}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                         IsVisible="{Binding HasSelectionActions}" />
              <!-- §6.7: Enter turns a multi-selection into a filter; this is its visible equivalent. -->
              <Button x:Name="ShowChosenRecordsButton" Margin="0,6,0,0" Content="Show their records (Enter)"
                      Click="ShowChosenRecords" IsVisible="{Binding HasMultiSelection}"
                      AutomationProperties.HelpText="Show the selected processes' records" />
            </StackPanel>
            <Border Classes="card" Margin="0,18,0,0" Padding="11" CornerRadius="8"
                    Background="{DynamicResource Surface.Elevated}">
              <StackPanel Spacing="10">
                <!-- Stated as the facts below it are, name above value: beside its name a long range wrapped a word at a time. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="Time scope" Classes="muted" />
                  <TextBlock x:Name="TimeScopeValue" Text="{Binding IntervalLabel}" TextWrapping="Wrap" />
                  <!-- R21: what the capture covered over the scope, beneath it, so every count below is read against it: a count
                       of none where the capture delivered nothing is not a quiet scope. Caution ink for a limit, as the strip's. -->
                  <TextBlock x:Name="TimeScopeCoverage" Text="{Binding ScopeCoverage}" TextWrapping="Wrap" FontSize="12"
                             Classes="muted" Classes.caution="{Binding ScopeCoverageLimited}"
                             IsVisible="{Binding ShowsScopeCoverage}" />
                </StackPanel>
                <!-- §6.8: a timeline cell chosen by a click, a step or the interval table is one action from how it was
                     counted: its lane's records and the rule behind them, what its bar plots, its column and its coverage. -->
                <StackPanel Spacing="3" IsVisible="{Binding HasCellExplanation}">
                  <TextBlock Text="How this cell was counted" Classes="muted" />
                  <TextBlock x:Name="CellExplanationText" Text="{Binding CellExplanation}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock x:Name="EvidenceHeadingText" Text="{Binding EvidenceHeading}" Classes="muted" />
                  <TextBlock x:Name="EvidenceSummaryText" Text="{Binding EvidenceSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- §6.8: a process's or a channel's numbers are one action from the rule behind them - how a process's
                     records were bound to it, and what the evidence policy left out, or how a channel's ends were paired. -->
                <StackPanel Spacing="3" IsVisible="{Binding HasExplanation}">
                  <TextBlock Text="{Binding ExplanationHeading}" Classes="muted" />
                  <TextBlock x:Name="ExplanationText" Text="{Binding Explanation}" TextWrapping="Wrap" />
                  <!-- What it says was left out, one action away: counted, as candidates, wherever the session is counted. -->
                  <!-- Its words wrap: the inspector is narrower than they are long at its narrowest. -->
                  <Button x:Name="CountCandidatesButton" Click="CountCandidates"
                          Margin="0,4,0,0" HorizontalAlignment="Left" IsVisible="{Binding OffersCandidates}"
                          AutomationProperties.HelpText="Count every reused PID's later holder's records as its own, as candidates, in every count, ranking and record list of this session">
                    <TextBlock Text="Count them as candidates" TextWrapping="Wrap" />
                  </Button>
                </StackPanel>
                <!-- Who started the process and whom it started (entities-v1's parent link): a parent named but not in the
                     capture stays a PID, never a guessed process. -->
                <StackPanel Spacing="3" IsVisible="{Binding ShowsLineage}">
                  <TextBlock Text="Started by" Classes="muted" />
                  <TextBlock x:Name="ParentText" Text="{Binding ParentText}" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ParentText, StringFormat='Started by {0}'}" />
                </StackPanel>
                <StackPanel Spacing="3" IsVisible="{Binding ShowsLineage}">
                  <TextBlock Text="Started" Classes="muted" />
                  <TextBlock x:Name="ChildrenText" Text="{Binding ChildrenText}" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ChildrenText, StringFormat='Started {0}'}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding LevelBadge}" Classes="muted" />
                  <TextBlock Text="{Binding LevelSummary}" TextWrapping="Wrap"
                             AutomationProperties.Name="What the current level accounts for" />
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- What can be done with the selection comes before the key to what the graph draws: at an ordinary window
                 height the actions were below the fold, under a scroll bar a hairline wide. -->
            <StackPanel Margin="0,18,0,0" Spacing="8">
              <Button x:Name="ShowRecordsButton" Content="Show source records (E)" IsEnabled="False"
                      Click="ShowSourceRecords"
                      AutomationProperties.HelpText="Show this rung's source records in the ladder" />
              <!-- The lineage the card states, one action away: the parent as the selection, the children as a set. -->
              <WrapPanel IsVisible="{Binding ShowsLineage}">
                <Button x:Name="SelectParentButton" Content="Go to parent" Click="SelectParent" Margin="0,0,8,0"
                        IsEnabled="{Binding CanSelectParent}"
                        AutomationProperties.HelpText="Select the process that started this one" />
                <Button x:Name="SelectChildrenButton" Content="{Binding SelectChildrenLabel}" Click="SelectChildren"
                        IsEnabled="{Binding CanSelectChildren}"
                        AutomationProperties.HelpText="Select the processes this one started" />
              </WrapPanel>
              <!-- Graph placement (§6.3, §19.4): the button equivalents of dragging a node and of L, so neither is gesture-only. -->
              <WrapPanel>
                <Button x:Name="PinNodeButton" Content="{Binding PinActionLabel}" IsEnabled="{Binding CanTogglePin}"
                        Click="TogglePinNode" Margin="0,0,8,0"
                        AutomationProperties.HelpText="Pin the selected graph node where it is drawn, or release its pin" />
                <Button x:Name="RelayoutButton" Content="Re-layout graph (L)" Click="RelayoutGraph"
                        IsEnabled="{Binding CanRelayoutGraph}"
                        AutomationProperties.HelpText="Lay the graph out afresh, keeping pinned nodes where they are" />
              </WrapPanel>
              <Button x:Name="BrowseChannelsButton" Content="Browse paired channels" IsEnabled="False"
                      Click="BrowseChannels"
                      AutomationProperties.HelpText="Browse all admitted paired TCP channels" />
              <!-- Offered while the rung lists something to export, and saying why not while it lists nothing. -->
              <Button x:Name="ExportButton" Content="Export this view (Ctrl+E)" Click="ExportView"
                      IsEnabled="{Binding CanExport}" ToolTip.Tip="{Binding ExportTip}" ToolTip.ShowOnDisabled="True"
                      AutomationProperties.HelpText="{Binding ExportTip}" />
              <Button x:Name="ShareRedactedButton" Content="Share redacted report" Click="ShareRedactedView"
                      IsEnabled="{Binding CanExport}" ToolTip.Tip="{Binding ShareReportTip}" ToolTip.ShowOnDisabled="True"
                      AutomationProperties.HelpText="{Binding ShareReportTip}" />
              <!-- A reopenable package of the whole session: pseudonymized, synthetic records, no original journal (§11.3). -->
              <Button x:Name="SharePackageButton" Content="Share redacted session…" Click="SharePackage" IsEnabled="False"
                      AutomationProperties.HelpText="Save a reopenable, pseudonymized copy of this session to share" />
              <!-- An exact, unredacted copy of the session's evidence that reopens as the same session (§11.3). -->
              <Button x:Name="ShareOriginalButton" Content="Share original session…" Click="ShareOriginal" IsEnabled="False"
                      AutomationProperties.HelpText="Save an exact, unredacted copy of this session's evidence to share" />
              <!-- A pin keeps the session's records from the time scope's start through every release, within the size it
                   allows (ADR-046); the same dialog lists the pins standing and removes one. -->
              <Button x:Name="KeepRecordsButton" Content="Keep records…" Click="KeepRecords" IsEnabled="False"
                      ToolTip.Tip="Open or record a session first." ToolTip.ShowOnDisabled="True"
                      AutomationProperties.HelpText="Keep this session's records from the time scope's start through every release, or remove a pin" />
              <!-- §20.6: what support needs to see why a capture or a view went wrong, and nothing a record holds (P16). -->
              <Button x:Name="SupportBundleButton" Content="Save support bundle…" Click="SaveSupportBundle"
                      AutomationProperties.HelpText="Save InterCat's version and this session's files, counts and coverage for support, with no names, addresses or content" />
            </StackPanel>
            <StackPanel Margin="0,20,0,0" Spacing="8">
              <TextBlock Text="EVIDENCE QUALITY" Classes="eyebrow" />
              <!-- A key to what the graph draws: evidence quality owns the dash pattern, never a hue or a mechanism's
                   glyph (§6.6), so each sample is the graph's own edge in body ink. -->
              <Border Classes="card" Padding="9" CornerRadius="7" Background="{DynamicResource Surface.Elevated}">
                <StackPanel x:Name="EvidenceQualityKey" Spacing="8">
                  <Grid ColumnDefinitions="36,*" ColumnSpacing="10"
                        AutomationProperties.Name="Solid line: direct, a source recorded the relationship">
                    <local:EvidenceKeySample Strength="Direct" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Direct" />
                      <TextBlock Text="a source recorded it" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="36,*" ColumnSpacing="10"
                        AutomationProperties.Name="Dashed line: correlated, linked by a documented rule">
                    <local:EvidenceKeySample Strength="Correlated" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Correlated" />
                      <TextBlock Text="linked by a documented rule" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="36,*" ColumnSpacing="10"
                        AutomationProperties.Name="Dotted line with a ring: candidate or unresolved, possible but not established">
                    <local:EvidenceKeySample Strength="Candidate" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Candidate" />
                      <TextBlock Text="or unresolved · possible, not established" Classes="muted" FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="{Binding WorkspaceDisclosure}" />
      </Grid>
    </Border>

    <!-- Accessible table equivalents: the same result set the canvas shows, reachable by keyboard (R15). -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="16,16,16,16" CornerRadius="10"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Ink.Accent}" BorderThickness="1"
            IsVisible="{Binding ShowTables}">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,*" Margin="16">
        <!-- Below the machine rung the table lists what the rung's graph draws, and counts what it leaves out (R15). -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="RELATIONSHIP TABLE" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock x:Name="RelationshipTableScopeText" Grid.Column="1" Margin="10,0" Text="{Binding RelationshipTableScope}"
                     Classes="muted" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding RelationshipTableScope}" />
        </Grid>
        <!-- Each end is named with its PID, so one executable's instances are told apart. -->
        <Grid Grid.Row="1" ColumnDefinitions="18,200,200,90,150,100" Margin="2,8,0,2">
          <TextBlock Grid.Column="1" Text="Source" Classes="columnHeader" />
          <TextBlock Grid.Column="2" Text="Target" Classes="columnHeader" />
          <TextBlock Grid.Column="3" Text="Mechanism" Classes="columnHeader" />
          <TextBlock Grid.Column="4" Text="Bytes" Classes="columnHeader" />
          <TextBlock Grid.Column="5" Text="Evidence" Classes="columnHeader" />
        </Grid>
        <ListBox x:Name="RelationshipList" Grid.Row="2" Margin="0,4,0,0"
                 ItemsSource="{Binding Relationships}"
                 SelectedItem="{Binding SelectedRelationship, Mode=TwoWay}"
                 DoubleTapped="OpenRelationshipRow"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Relationship table, the table equivalent of the communication graph">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pres:RelationshipRow">
              <Grid ColumnDefinitions="18,200,200,90,150,100" Margin="2,4">
                <TextBlock Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{Binding Source}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
                <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="{Binding Target}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" />
                <TextBlock Grid.Column="3" Text="{Binding Mechanism}" Classes="muted" />
                <TextBlock Grid.Column="4" Text="{Binding KnownBytes}" />
                <TextBlock Grid.Column="5" Text="{Binding Evidence}" Classes="muted" ToolTip.Tip="{Binding Explanation}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- A table listing none says why in its place, as the graph's caption does (R21). -->
        <TextBlock x:Name="RelationshipsAbsentText" Grid.Row="2" Margin="2,8,0,0" Classes="muted" FontSize="12"
                   TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding RelationshipsAbsent}"
                   IsVisible="{Binding RelationshipsAbsent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.Name="Why the relationship table lists none" />

        <!-- The selected relationship in words: what its evidence's tooltip says, for a keyboard as for a pointer (R4). -->
        <TextBlock x:Name="SelectedRelationshipText" Grid.Row="3" Margin="2,6,0,0" Classes="muted" FontSize="11"
                   TextWrapping="Wrap" Text="{Binding SelectedRelationshipExplanation}"
                   IsVisible="{Binding HasSelectedRelationship}"
                   AutomationProperties.Name="The selected relationship, explained" />

        <Grid Grid.Row="4" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="INTERVAL TABLE" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding IntervalTableScope}" Classes="muted"
                     FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding IntervalTableScope}" />
          <ComboBox x:Name="TimelineLaneSelector" Grid.Column="2" Width="175" MinHeight="32"
                    ItemsSource="{Binding TimelineLaneOptions}"
                    SelectedItem="{Binding SelectedTimelineLane, Mode=TwoWay}"
                    IsVisible="{Binding ShowsMechanismLanes}"
                    AutomationProperties.Name="Mechanism lane for the interval table and bracket-key stepping">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:TimelineLaneOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox x:Name="DirectionLaneSelector" Grid.Column="2" Width="175" MinHeight="32"
                    ItemsSource="{Binding DirectionLaneOptions}"
                    SelectedItem="{Binding SelectedDirectionLane, Mode=TwoWay}"
                    IsVisible="{Binding ShowsDirectionLanes}"
                    AutomationProperties.Name="Source direction lane for the interval table and bracket-key stepping">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:DirectionLaneOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox x:Name="ChannelEndSelector" Grid.Column="2" Width="175" MinHeight="32"
                    ItemsSource="{Binding ChannelEndOptions}"
                    SelectedItem="{Binding SelectedChannelEndOption, Mode=TwoWay}"
                    IsVisible="{Binding ShowsChannelEndLanes}"
                    AutomationProperties.Name="Channel end for the interval table and bracket-key stepping">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ChannelEndOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="GroupTotalsButton" Grid.Column="3" Margin="8,0,0,0" Content="Group totals"
                  Click="ClearTimelineProcessFocus" IsVisible="{Binding HasSelectedProcessLane}"
                  AutomationProperties.HelpText="Clear the selected process lane and show group interval totals" />
        </Grid>
        <!-- Bytes come last: a real session's timeline sums none per interval, so its rows' bytes are read once the table
             is shown, sent and received apart; a session with no directory to read them from leaves the column out. -->
        <!-- A window on the wall clock is wider than one in session time, and one across days wraps within its column
             rather than running under the count beside it. The coverage column holds "partial gap, not extrapolated",
             which every interval before a release's boundary states, and a longer state wraps within it rather than
             running under the bytes; the bytes take what width is left, and trim to it. -->
        <Grid Grid.Row="5" ColumnDefinitions="18,224,170,210,*" Margin="2,8,0,2">
          <TextBlock Grid.Column="1" Text="Window" Classes="columnHeader" />
          <TextBlock Grid.Column="2" Text="Observations" Classes="columnHeader" />
          <TextBlock Grid.Column="3" Text="Coverage" Classes="columnHeader" />
          <TextBlock Grid.Column="4" Text="Bytes" Classes="columnHeader" IsVisible="{Binding IntervalTableShowsBytes}" />
        </Grid>
        <ListBox x:Name="IntervalList" Grid.Row="6" Margin="0,4,0,0"
                 ItemsSource="{Binding Intervals}"
                 SelectedItem="{Binding SelectedIntervalRow, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Interval table, the table equivalent of the activity timeline">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pres:IntervalRow">
              <Grid ColumnDefinitions="18,224,170,210,*" Margin="2,4">
                <TextBlock Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Text="{Binding Window}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Observations}" />
                <TextBlock Grid.Column="3" Text="{Binding Coverage}" Classes="muted" TextWrapping="Wrap" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="{Binding KnownBytes}" IsVisible="{Binding ShowsBytes}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KnownBytes}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Health strip -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Padding="16,0"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Line.Divider}" BorderThickness="0,1,0,0">
      <!-- Health strip: capture state and whether the view follows it, the generation shown, coverage, the loss the
           capture has stated, and how recent its last publication is (§3.1 step 3, §20.6). -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="HealthDot" Text="●" Classes="muted" />
        <TextBlock x:Name="HealthStateText" Grid.Column="1" Margin="6,0,16,0" Text="Ready" FontSize="11"
                   Foreground="{DynamicResource Ink.Body}" AutomationProperties.Name="Capture and view state" />
        <TextBlock x:Name="WorkspaceTitleText" Grid.Column="2" Margin="0,0,16,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                   Text="{Binding Title}" ToolTip.Tip="{Binding Title}"
                   Classes="muted" FontSize="11" />
        <!-- Coverage reads as a warning only when it is limited; complete coverage is a plain statement. -->
        <TextBlock x:Name="CoverageSummaryText" Grid.Column="3" Text="{Binding CoverageSummary}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CoverageSummary}"
                   Classes="muted" Classes.caution="{Binding CoverageLimited}" FontSize="11" />
        <TextBlock x:Name="HealthLossText" Grid.Column="4" Margin="16,0,0,0" FontSize="11"
                   Foreground="{DynamicResource Ink.Body}" AutomationProperties.Name="Loss the capture has stated" />
        <TextBlock x:Name="HealthFreshnessText" Grid.Column="5" Margin="16,0,0,0" Classes="muted" FontSize="11"
                   AutomationProperties.Name="How recent the last publication is" />
      </Grid>
    </Border>

    <!-- Hover cards are drawn above every pane, so a card is never clipped by the pane its mark is in (section 6.2). -->
    <local:HoverOverlay x:Name="HoverLayer" Grid.RowSpan="4" Grid.ColumnSpan="3" />
  </Grid>
</Window>
