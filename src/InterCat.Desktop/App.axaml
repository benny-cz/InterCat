<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterCat.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Surface.Canvas}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Body}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <!-- The primary action has tokens of its own, measured with the ink drawn on them (§6.6). The theme's pointer-over
         and pressed looks would turn it back into an ordinary button with text of unmeasured contrast, so its states
         are restated here; a disabled primary action keeps the theme's disabled look. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Action.Fill}" />
      <Setter Property="Foreground" Value="{DynamicResource Action.Ink}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Action.FillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Action.Ink}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Action.FillPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource Action.Ink}" />
    </Style>
    <!-- A card edges itself with the divider: the card's own tone in the dark and light modes, a line to be seen in high
         contrast. Its padding is a pixel less than its content inset, so the edge moves nothing (§6.1). -->
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource Line.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A list lies on the surface it is placed in, as the main window's lists always did: the control theme's own grey
         is no surface the report measures an ink on. -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A row of a list, or of a combo box's open list, in every mode (§6.1). Under the pointer or pressed it lies on
         the elevated face, where every ink a row carries is measured; selected, it is also ringed in the accent, since
         no fill both stands apart from the ground and keeps muted ink legible on it. The ring is drawn inside the row,
         so selecting one moves nothing. The control theme's own tints follow the platform's accent colour. -->
    <Style Selector=":is(ListBoxItem)">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector=":is(ListBoxItem):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Elevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Body}" />
    </Style>
    <Style Selector=":is(ListBoxItem):pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Elevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Body}" />
    </Style>
    <Style Selector=":is(ListBoxItem):selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface.Elevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.Body}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ListItem.SelectedRing}" />
    </Style>
    <!-- Text selected in a text box or a selectable block is the action pair: the ink the report measures on its fill. -->
    <Style Selector="TextBox">
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Action.Ink}" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource Action.Fill}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Action.Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Muted}" />
    </Style>
    <Style Selector="TextBlock.accent">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Accent}" />
    </Style>
    <!-- A warning in words: caution ink, never a mechanism's hue. Declared after muted, so it wins when both apply. -->
    <Style Selector="TextBlock.caution">
      <Setter Property="Foreground" Value="{DynamicResource Status.Caution}" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource Ink.Accent}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>
  </Application.Styles>
</Application>
