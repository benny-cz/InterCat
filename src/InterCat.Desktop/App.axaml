<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterCat.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#08111E" />
      <Setter Property="Foreground" Value="#E8F0FA" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1687D9" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A4BA" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#72C5F7" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>
  </Application.Styles>
</Application>
